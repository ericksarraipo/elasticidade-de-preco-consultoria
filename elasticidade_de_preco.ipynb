   "metadata": {},
   "source": [
    "# Elasticidade de preço: simulador de reajuste para consultoria de pricing\n",
    "\n",
    "Notebook que reúne o projeto de ponta a ponta:\n",
    "\n",
    "1. Geração de dados sintéticos de vendas (preço x quantidade) para 5 produtos\n",
    "2. Validação de qualidade dos dados\n",
    "3. Estimação da elasticidade-preço por produto (regressão log-log)\n",
    "4. Camada de dados `raw/` e `curated/` particionada por data (mesma estrutura usada no S3)\n",
    "5. Gráficos e simulador interativo de reajuste de preço\n",
    "\n"
   "id": "cel00"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Célula 1: imports e configurações\n",
    "import json\n",
    "from datetime import date\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "try:\n",
    "    from ipywidgets import Dropdown, IntSlider, interact\n",
    "except ImportError:  # fora do Colab/Jupyter\n",
    "    interact = None\n",
    "\n",
    "RNG = np.random.default_rng(42)\n",
    "SEMANAS = 104        # semanas de histórico\n",
    "JANELA_ATUAL = 12    # semanas que definem o preço e o volume \"atuais\"\n",
    "VARIACOES = range(-20, 41)  # cenários de -20% a +40% no preço\n",
    "BASE = Path(\"pricing_project\")"
   ],
   "id": "cel01"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Célula 2: dados sintéticos de vendas (as elasticidades verdadeiras ficam só aqui)\n",
    "# id, nome, preço base (R$), custo unitário (R$), qtd semanal base, elasticidade verdadeira\n",
    "PRODUTOS = [\n",
    "    (\"p1\", \"Plano Premium\", 129.0, 52.0, 900, -2.3),\n",
    "    (\"p2\", \"Plano Essencial\", 79.0, 41.0, 2200, -1.7),\n",
    "    (\"p3\", \"Combo Família\", 189.0, 96.0, 520, -1.3),\n",
    "    (\"p4\", \"Add-on Segurança\", 24.9, 6.0, 3100, -0.8),\n",
    "    (\"p5\", \"Plano Empresarial\", 349.0, 170.0, 210, -1.1),\n",
    "]\n",
    "\n",
    "\n",
    "def gerar() -> pd.DataFrame:\n",
    "    datas = pd.date_range(\"2024-01-01\", periods=SEMANAS, freq=\"W-MON\")\n",
    "    linhas = []\n",
    "    for pid, nome, p0, custo, q0, e in PRODUTOS:\n",
    "        mult = 1.0\n",
    "        for i, data in enumerate(datas):\n",
    "            if i % 6 == 0:  # reajustes e testes de preço a cada ~6 semanas\n",
    "                mult = RNG.choice([0.90, 0.95, 1.00, 1.05, 1.10, 1.15])\n",
    "            promo = int(RNG.random() < 0.10)\n",
    "            preco = round(p0 * mult * (0.90 if promo else 1.0), 2)\n",
    "            sazonal = 0.15 * np.sin(2 * np.pi * i / 52)\n",
    "            ln_q = np.log(q0) + e * np.log(preco / p0) + sazonal + 0.10 * promo + RNG.normal(0, 0.07)\n",
    "            linhas.append((data.date().isoformat(), pid, nome, preco, custo, int(round(np.exp(ln_q))), promo))\n",
    "    return pd.DataFrame(linhas, columns=[\"data\", \"produto_id\", \"produto\", \"preco\", \"custo\", \"quantidade\", \"promo\"])\n",
    "\n",
    "\n",
    "vendas = gerar()\n",
    "vendas.head()"
   ],
   "id": "cel02"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Célula 3: validação de qualidade dos dados\n",
    "COLUNAS = [\"data\", \"produto_id\", \"produto\", \"preco\", \"custo\", \"quantidade\", \"promo\"]\n",
    "\n",
    "\n",
    "def validar(df: pd.DataFrame) -> None:\n",
    "    ausentes = set(COLUNAS) - set(df.columns)\n",
    "    if ausentes:\n",
    "        raise ValueError(f\"Colunas ausentes: {sorted(ausentes)}\")\n",
    "    erros = []\n",
    "    if df[COLUNAS].isna().any().any():\n",
    "        erros.append(\"há valores nulos\")\n",
    "    if (df[\"preco\"] <= 0).any():\n",
    "        erros.append(\"preço menor ou igual a zero\")\n",
    "    if (df[\"quantidade\"] < 0).any():\n",
    "        erros.append(\"quantidade negativa\")\n",
    "    if not df[\"promo\"].isin([0, 1]).all():\n",
    "        erros.append(\"promo fora de {0, 1}\")\n",
    "    if df.duplicated([\"data\", \"produto_id\"]).any():\n",
    "        erros.append(\"linhas duplicadas por data e produto\")\n",
    "    semanas = df.groupby(\"produto_id\").size()\n",
    "    if semanas.nunique() != 1:\n",
    "        erros.append(f\"número de semanas diferente entre produtos: {semanas.to_dict()}\")\n",
    "    if erros:\n",
    "        raise ValueError(\"Falha na qualidade dos dados: \" + \"; \".join(erros))\n",
    "\n",
    "\n",
    "validar(vendas)\n",
    "print(f\"Qualidade OK: {len(vendas)} linhas, {vendas['produto_id'].nunique()} produtos\")"
   ],
   "id": "cel03"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Célula 4: elasticidade-preço (regressão log-log) e simulação de margem\n",
    "# ln(quantidade) = b0 + e * ln(preço) + sazonalidade anual (seno/cosseno) + promoção\n",
    "def mqo(X, y):\n",
    "    beta, *_ = np.linalg.lstsq(X, y, rcond=None)\n",
    "    res = y - X @ beta\n",
    "    n, k = X.shape\n",
    "    s2 = res @ res / (n - k)\n",
    "    erro_padrao = np.sqrt(np.diag(s2 * np.linalg.inv(X.T @ X)))\n",
    "    r2 = 1 - (res @ res) / ((y - y.mean()) @ (y - y.mean()))\n",
    "    return beta, erro_padrao, r2\n",
    "\n",
    "\n",
    "def analisar(grupo: pd.DataFrame) -> dict:\n",
    "    g = grupo.sort_values(\"data\")\n",
    "    dia = pd.to_datetime(g[\"data\"]).dt.dayofyear.to_numpy()\n",
    "    X = np.column_stack([\n",
    "        np.ones(len(g)),\n",
    "        np.log(g[\"preco\"].to_numpy()),\n",
    "        np.sin(2 * np.pi * dia / 365.25),\n",
    "        np.cos(2 * np.pi * dia / 365.25),\n",
    "        g[\"promo\"].to_numpy(),\n",
    "    ])\n",
    "    y = np.log(g[\"quantidade\"].to_numpy())\n",
    "    beta, ep, r2 = mqo(X, y)\n",
    "    e = float(beta[1])\n",
    "\n",
    "    recente = g.tail(JANELA_ATUAL)\n",
    "    p0 = float(recente[\"preco\"].median())\n",
    "    q0 = float(recente[\"quantidade\"].mean())\n",
    "    custo = float(g[\"custo\"].iloc[-1])\n",
    "\n",
    "    curva = []\n",
    "    for v in VARIACOES:\n",
    "        p = p0 * (1 + v / 100)\n",
    "        q = q0 * (p / p0) ** e\n",
    "        curva.append({\"variacao\": v, \"preco\": round(p, 2), \"qtd\": round(q, 1),\n",
    "                      \"receita\": round(p * q, 2), \"margem\": round((p - custo) * q, 2)})\n",
    "    atual = next(c for c in curva if c[\"variacao\"] == 0)\n",
    "    otimo = max(curva, key=lambda c: c[\"margem\"])\n",
    "\n",
    "    return {\n",
    "        \"id\": g[\"produto_id\"].iloc[0], \"nome\": g[\"produto\"].iloc[0],\n",
    "        \"preco_atual\": round(p0, 2), \"custo\": custo, \"qtd_semana\": round(q0, 1),\n",
    "        \"elasticidade\": round(e, 2), \"erro_padrao\": round(float(ep[1]), 2), \"r2\": round(float(r2), 3),\n",
    "        \"classificacao\": \"Elástico\" if e < -1 else \"Inelástico\",\n",
    "        \"faixa_historica\": [round((g[\"preco\"].min() / p0 - 1) * 100), round((g[\"preco\"].max() / p0 - 1) * 100)],\n",
    "        \"curva\": curva,\n",
    "        \"otimo\": {**otimo, \"ganho_margem_pct\": round((otimo[\"margem\"] / atual[\"margem\"] - 1) * 100, 1),\n",
    "                  \"no_limite\": otimo[\"variacao\"] == max(VARIACOES)},\n",
    "    }\n",
    "\n",
    "\n",
    "produtos = [analisar(g) for _, g in vendas.groupby(\"produto_id\")]"
   ],
   "id": "cel04"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Célula 5: camada de dados (mesma estrutura raw/curated particionada por data usada no S3)\n",
    "dt = date.today().isoformat()\n",
    "raw = BASE / \"raw\" / \"vendas_semanais\" / f\"dt={dt}\"\n",
    "curated = BASE / \"curated\" / \"elasticidade_resumo\" / f\"dt={dt}\"\n",
    "for pasta in (raw, curated):\n",
    "    pasta.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "resumo = pd.DataFrame([{\n",
    "    \"produto_id\": p[\"id\"], \"produto\": p[\"nome\"], \"elasticidade\": p[\"elasticidade\"],\n",
    "    \"ic95\": round(1.96 * p[\"erro_padrao\"], 2), \"r2\": p[\"r2\"], \"classificacao\": p[\"classificacao\"],\n",
    "    \"preco_atual\": p[\"preco_atual\"], \"preco_otimo\": p[\"otimo\"][\"preco\"],\n",
    "    \"ganho_margem_pct\": p[\"otimo\"][\"ganho_margem_pct\"], \"no_limite\": int(p[\"otimo\"][\"no_limite\"]),\n",
    "} for p in produtos])\n",
    "\n",
    "vendas.to_csv(raw / \"vendas.csv\", index=False)\n",
    "resumo.to_csv(curated / \"resumo.csv\", index=False)\n",
    "# mesmo formato que alimenta o dashboard React (dashboard/public/data.json)\n",
    "(BASE / \"data.json\").write_text(json.dumps({\"produtos\": produtos}, ensure_ascii=False), encoding=\"utf-8\")\n",
    "resumo"
   ],
   "id": "cel05"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Célula 6: gráficos\n",
    "AMBAR = \"#f2b33d\"\n",
    "\n",
    "# 6.1 Elasticidade estimada com intervalo de confiança de 95%\n",
    "fig, ax = plt.subplots(figsize=(7, 3.5))\n",
    "ax.barh(resumo[\"produto\"], resumo[\"elasticidade\"], xerr=resumo[\"ic95\"], color=\"#3b6edc\", capsize=4)\n",
    "ax.axvline(-1, color=\"gray\", linestyle=\"--\", label=\"Elasticidade = -1\")\n",
    "ax.set_xlabel(\"Elasticidade-preço (IC 95%)\")\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 6.2 Curva de margem por produto, com o ponto de margem máxima\n",
    "fig, eixos = plt.subplots(2, 3, figsize=(12, 6), sharex=True)\n",
    "for ax, p in zip(eixos.ravel(), produtos):\n",
    "    ax.plot([c[\"variacao\"] for c in p[\"curva\"]], [c[\"margem\"] for c in p[\"curva\"]], color=AMBAR, lw=2.5)\n",
    "    ax.scatter([p[\"otimo\"][\"variacao\"]], [p[\"otimo\"][\"margem\"]], color=\"black\", zorder=3)\n",
    "    ax.axvspan(*p[\"faixa_historica\"], alpha=0.12)\n",
    "    ax.set_title(f'{p[\"nome\"]} (e = {p[\"elasticidade\"]})')\n",
    "for ax in eixos.ravel()[len(produtos):]:\n",
    "    ax.axis(\"off\")\n",
    "fig.supxlabel(\"Variação de preço (%). Faixa sombreada: preços observados no histórico\")\n",
    "fig.supylabel(\"Margem semanal (R$)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ],
   "id": "cel06"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Célula 7: simulador interativo de reajuste\n",
    "def brl(v):\n",
    "    return f\"R$ {v:,.2f}\".replace(\",\", \"X\").replace(\".\", \",\").replace(\"X\", \".\")\n",
    "\n",
    "\n",
    "def simular(produto=\"Plano Premium\", variacao=0):\n",
    "    p = next(x for x in produtos if x[\"nome\"] == produto)\n",
    "    atual = next(c for c in p[\"curva\"] if c[\"variacao\"] == 0)\n",
    "    sim = next(c for c in p[\"curva\"] if c[\"variacao\"] == variacao)\n",
    "    o = p[\"otimo\"]\n",
    "    fmin, fmax = p[\"faixa_historica\"]\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(7, 3.5))\n",
    "    ax.plot([c[\"variacao\"] for c in p[\"curva\"]], [c[\"margem\"] for c in p[\"curva\"]], color=AMBAR, lw=2.5)\n",
    "    ax.scatter([o[\"variacao\"]], [o[\"margem\"]], color=AMBAR, edgecolors=\"black\", s=90, zorder=3, label=\"Margem máxima\")\n",
    "    ax.scatter([variacao], [sim[\"margem\"]], facecolors=\"none\", edgecolors=\"black\", s=110, zorder=3, label=\"Cenário\")\n",
    "    ax.axvspan(fmin, fmax, alpha=0.12, label=\"Faixa histórica\")\n",
    "    ax.set_xlabel(\"Variação de preço (%)\")\n",
    "    ax.set_ylabel(\"Margem semanal (R$)\")\n",
    "    ax.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    delta = (sim[\"margem\"] / atual[\"margem\"] - 1) * 100\n",
    "    print(f'{produto}: elasticidade {p[\"elasticidade\"]} ({p[\"classificacao\"].lower()})')\n",
    "    print(f'Preço simulado: {brl(sim[\"preco\"])} ({variacao:+d}% vs. {brl(atual[\"preco\"])})')\n",
    "    print(f'Margem semanal: {brl(sim[\"margem\"])} ({delta:+.1f}% vs. atual) | Receita: {brl(sim[\"receita\"])}')\n",
    "    print(f'Preço de margem máxima: {brl(o[\"preco\"])} ({o[\"variacao\"]:+d}%), ganho de {o[\"ganho_margem_pct\"]:+.1f}%')\n",
    "    if variacao < fmin or variacao > fmax:\n",
    "        print(f\"Atenção: fora da faixa histórica ({fmin}% a +{fmax}%). O resultado é extrapolação do modelo.\")\n",
    "\n",
    "\n",
    "if interact:\n",
    "    interact(simular, produto=Dropdown(options=[p[\"nome\"] for p in produtos]),\n",
    "             variacao=IntSlider(min=-20, max=40, step=1, value=0))\n",
    "else:\n",
    "    simular(\"Plano Premium\", 10)"
   ],
   "id": "cel07"
  }
